# Public browser-safe values only. Never place service-role or Azure secrets here.
NEXT_PUBLIC_SITE_URL=https://console.quantifyterminal.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-site-key

# Server-side public endpoint; privileged calls still require the caller's bearer token.
QT_ACCOUNT_API_URL=https://example-account-api.azurewebsites.net/api/v1

# The release deploy function's origin. Release publishing lives in this console, so
# without it there is no way to ship a desktop update. It carries no credential: the
# function authorises the signed-in Owner's own bearer token, and signs with a key it
# fetches from Key Vault itself.
QT_UPDATE_DEPLOY_URL=https://func-quantify-updates-prod.azurewebsites.net/api

# Optional read-only preflight targets.
QT_MARKETING_SITE_URL=https://www.quantifyterminal.com
QT_DESKTOP_PROJECT_PATH=../Quantify Terminal
